---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Eko Design — Marie Arnaud, Product Designer',
  description = "Marie Arnaud — Product Designer senior spécialisée dans l'expérience de conversion. Sephora, SNCF, Pandacraft, Aigle. Nantes / Paris.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="fr" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <!-- Appliqué avant le premier rendu : évite le flash dark → light -->
    <script is:inline>
      try {
        document.documentElement.setAttribute('data-theme', localStorage.getItem('eko-theme') || 'dark');
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <slot />
  </body>
</html>
