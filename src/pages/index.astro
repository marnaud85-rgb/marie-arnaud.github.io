---
import Base from '../layouts/Base.astro';
import HeatFilter from '../components/HeatFilter.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import MokaChat from '../components/MokaChat.astro';
import AboutCard from '../components/AboutCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactTile from '../components/ContactTile.astro';
import Footer from '../components/Footer.astro';

const skills = [
  'Design system', 'Maze', 'Ux research', 'User testing', 'Content square',
  'Aninix', 'iOS 26', 'Baymard & autres', 'Dev Notion Web', 'json / lottie',
];
const passions = [
  'Zelda Tears of the Kingdom', "Design d'intérieur", 'Culture japonaise', 'Bouquiner',
];
---
<Base>
  <HeatFilter />
  <Nav />
  <main id="main">
  <Hero />
  <Marquee />
  <MokaChat />

  <!-- ══ À PROPOS ══ -->
  <section class="section" id="about">
    <div class="sec-label">À propos</div>
    <div class="sec-title">Marie Arnaud</div>
    <div class="cards-grid">

      <AboutCard label="Profil" title="Product designer senior, spécialiste conversion" flex={1.8} minWidth={480}>
        <div class="card-body">
          Je suis passée du mode agence au mode produit. L'agence m'a appris la vélocité et la polyvalence. Passer d'un projet UI le lundi à un sujet complexe le mercredi.<br /><br />
          Sephora m'a donné la profondeur : méthodo Scrum, grands process, et une expertise forte sur les tunnels de conversion.<br /><br />
          Curieuse et ambitieuse, j'adore pousser le curseur de l'innovation dans mes projets. Ma méthode&nbsp;? Sécuriser et dé-risquer mes choix design grâce aux feedbacks users et à la data, pour ensuite livrer des solutions créatives sur mesure. Véritable early adopter, je passe mon temps à tester les dernières bêtas de Figma. Ce site est une démo de mon savoir-faire. N'hésitez pas à poser vos questions à Moka&nbsp;!
        </div>
      </AboutCard>

      <AboutCard label="Hors design" title="Passions" flex={1} minWidth={320}>
        <div class="card-body" style="display:flex;flex-direction:column;gap:8px">
          {passions.map((p) => <span>→ {p}</span>)}
        </div>
      </AboutCard>

      <AboutCard label="Poste actuel · 4 ans" title="Sephora" flex={1.2} minWidth={340}>
        <div class="card-body">
          Scope Convert · Web &amp; App · International<br /><br />
          Je pilote l'expérience du checkout, du panier à la confirmation d'achat. Réconcilier les contraintes business, tech et légales pour en faire un parcours fluide : c'est mon quotidien.
        </div>
      </AboutCard>

      <AboutCard label="Expertise" title="En vrac" flex={1.8} minWidth={480}>
        <div class="skill-tags">
          {skills.map((s) => <span class="skill-pill">{s}</span>)}
        </div>
      </AboutCard>

    </div>
  </section>

  <!-- ══ PROJETS ══ -->
  <section class="section" id="projects">
    <div class="sec-label">Projet</div>
    <div class="sec-title">Concret</div>
    <p style="font-size:14px;font-weight:600;color:var(--t2);margin-bottom:var(--s24);line-height:1.6">
      ℹ️ À noter que la majorité des projets clients avec lesquels j'ai travaillé ont une clause de confidentialité. Les réalisations présentées ici sont celles pour lesquelles j'ai obtenu l'autorisation de partage.
    </p>
    <div class="projects-grid">

      <ProjectCard
        label="E-commerce"
        title="Pandacraft"
        href="https://www.pandacraft.fr"
        quote="J'ai eu la chance de travailler un bon moment avec Swan Robbes. On collaborait au quotidien via un backlog Asana, un outil que j'apprécie beaucoup, bien plus agréable que Jira à mon goût. 😊"
      >
        Optimisation UX du tunnel d'abonnement, renforcement UI sur les modules gammes &amp; kits et conception d'un design system cohérent from scratch.
      </ProjectCard>

      <ProjectCard
        label="Transport"
        title="SNCF Abonnement"
        href="https://www.abonnement-regional.sncf/region/PDL/produit/UF08_DIGITAL_Abonnement%20tutti%20annuel%20monomodal%20NASA"
        quote="J'ai collaboré directement avec les équipes design de la SNCF, avec une répartition selon les produits. C'est là que j'ai vraiment mis le pied à l'étrier sur l'accessibilité."
      >
        Refonte d'une plateforme d'abonnement TER en marque blanche. Souscription, paiement et espace abonné responsive.
      </ProjectCard>

      <ProjectCard
        label="Mode & Outdoor"
        title="Aigle"
        href="https://www.aigle.com/fr/fr/p/aiw25mout003-BJ99_avocat.html"
        quote="Beaucoup d'UX Research aussi : tests utilisateurs, benchmarks… L'idée était de dé-risquer nos hypothèses, de la hiérarchisation de la page jusqu'aux mécanismes de sélection."
      >
        Refonte de la page produit pour valoriser les caractéristiques techniques et améliorer la conversion.
      </ProjectCard>

    </div>
  </section>

  <!-- ══ CONTACT — Discutons ══ -->
  <section class="section" id="contact">
    <div class="sec-label">Contact</div>
    <div class="sec-title">Discutons</div>
    <div class="discutons-grid">
      <ContactTile color="indigo" src="/assets/contact-tiles/tile-cat-glasses.svg" heat />
      <ContactTile color="blue" src="/assets/contact-tiles/tile-behance.svg" href="https://www.behance.net/mariearnaud" label="Behance — Marie Arnaud" external />
      <ContactTile color="pink" src="/assets/contact-tiles/tile-flower.svg" heat />
      <ContactTile color="green" src="/assets/contact-tiles/tile-linkedin.svg" href="https://www.linkedin.com/in/marie-arnaud-437a3b172/" label="LinkedIn — Marie Arnaud" external />
      <ContactTile color="punchy" src="/assets/contact-tiles/tile-email.svg" href="mailto:m.arnaud85@icloud.com" label="Envoyer un email à Marie Arnaud" />
      <ContactTile color="green" src="/assets/contact-tiles/tile-moka-face.svg" heat />
    </div>
  </section>
  </main>

  <Footer />
</Base>
