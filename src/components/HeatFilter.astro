---
// Filtre SVG "heat distortion" — défini une fois, appliqué via .tile-fx-heat.
// 0 JS, ~1 Ko. Actif au survol seulement (voir base.css).
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <filter id="heatDistortion" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" numOctaves="2" seed="7" result="noise">
        <animate attributeName="baseFrequency"
                 values="0.0073 0.011; 0.018 0.027; 0.0073 0.011"
                 keyTimes="0; 0.5; 1" calcMode="spline"
                 keySplines="0.5 0 0.5 1; 0.445 0.05 0.55 0.95"
                 dur="1.6s" repeatCount="indefinite"></animate>
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="noise" xChannelSelector="R" yChannelSelector="G">
        <animate attributeName="scale"
                 values="18.8; 31.2; 18.8"
                 keyTimes="0; 0.5; 1" calcMode="spline"
                 keySplines="0.5 0 0.5 1; 0.445 0.05 0.55 0.95"
                 dur="1.6s" repeatCount="indefinite"></animate>
      </feDisplacementMap>
    </filter>
  </defs>
</svg>
