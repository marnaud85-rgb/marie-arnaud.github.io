---
import ArrowIcon from './ArrowIcon.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import { useT, defaultLang } from '../i18n';

const lang = Astro.currentLocale ?? defaultLang;
const t = useT(lang);
---
<nav aria-label={t.nav.label}>
  <a href="#" class="nav-logo" aria-label={t.nav.logo}>
    <img src="/assets/App_Icon.svg" alt={t.nav.logo} width="28" height="28" style="display:block;object-fit:contain" />
  </a>

  <ul class="nav-links">
    <li><a href="#about">{t.nav.about}</a></li>
    <li><a href="#projects">{t.nav.projects}</a></li>
    <li><a href="#contact">{t.nav.contact}</a></li>
  </ul>

  <div class="nav-right">
    <a href="https://www.linkedin.com/in/marie-arnaud-437a3b172/" target="_blank" rel="noopener" class="btn-secondary nav-linkedin">
      <span>{t.nav.linkedin}</span>
      <ArrowIcon />
    </a>
    <a href="https://www.behance.net/mariearnaud" target="_blank" rel="noopener" class="btn-secondary nav-behance">
      <span>{t.nav.behance}</span>
      <ArrowIcon />
    </a>
    <LangToggle />
    <ThemeToggle />
  </div>
</nav>
