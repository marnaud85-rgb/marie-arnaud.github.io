---
import ArrowIcon from './ArrowIcon.astro';
---
<nav>
  <a href="#" class="nav-logo" aria-label="Eko Design">
    <img src="/assets/App_Icon.svg" alt="Eko Design" width="28" height="28" style="display:block;object-fit:contain" />
  </a>

  <ul class="nav-links">
    <li><a href="#about">À propos</a></li>
    <li><a href="#projects">Projets</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>

  <div class="nav-right">
    <a href="https://www.linkedin.com/in/marie-arnaud-437a3b172/" target="_blank" rel="noopener" class="btn-secondary">
      <span>LinkedIn</span>
      <ArrowIcon />
    </a>
    <a href="https://www.behance.net/mariearnaud" target="_blank" rel="noopener" class="btn-secondary nav-behance">
      <span>Behance</span>
      <ArrowIcon />
    </a>
    <button class="btn-icon" id="theme-btn" aria-label="Changer de thème">
      <svg class="theme-ic theme-ic-sun" xmlns="http://www.w3.org/2000/svg" height="18" width="18" viewBox="0 -960 960 960" aria-hidden="true">
        <path d="M565-395q35-35 35-85t-35-85q-35-35-85-35t-85 35q-35 35-35 85t35 85q35 35 85 35t85-35Zm-226.5 56.5Q280-397 280-480t58.5-141.5Q397-680 480-680t141.5 58.5Q680-563 680-480t-58.5 141.5Q563-280 480-280t-141.5-58.5ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Zm326-268Z"></path>
      </svg>
      <svg class="theme-ic theme-ic-moon" xmlns="http://www.w3.org/2000/svg" height="18" width="18" viewBox="0 -960 960 960" aria-hidden="true">
        <path d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Zm0-80q88 0 158-48.5T740-375q-20 5-40 8t-40 3q-123 0-209.5-86.5T364-660q0-20 3-40t8-40q-78 32-126.5 102T200-480q0 116 82 198t198 82Zm-10-270Z"></path>
      </svg>
    </button>
  </div>
</nav>

<script>
  const html = document.documentElement;
  document.getElementById('theme-btn')?.addEventListener('click', () => {
    const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    try { localStorage.setItem('eko-theme', next); } catch (e) {}
  });
</script>
